#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.0"
    }
    defaultPrim = "hunter_se_description"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "hunter_se_description" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "NewtonArticulationRootAPI"]
)
{
    def Scope "Physics"
    {
        def PhysicsRevoluteJoint "fr_steer_left_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </hunter_se_description/Geometry/base_link>
            rel physics:body1 = </hunter_se_description/Geometry/base_link/fr_steer_left_link>
            point3f physics:localPos0 = (0.34058, 0.24619, -0.1535)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -22.0
            float physics:upperLimit = 22.0
            custom float urdf:limit:effort = 0
            custom float urdf:limit:velocity = 0
            float drive:angular:physics:stiffness = 10000000.0
            float drive:angular:physics:damping = 100000.0
            float drive:angular:physics:maxForce = 6000.0
            float drive:angular:physics:targetPosition = 0.0
        }

        def PhysicsRevoluteJoint "fr_left_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </hunter_se_description/Geometry/base_link/fr_steer_left_link>
            rel physics:body1 = </hunter_se_description/Geometry/base_link/fr_steer_left_link/fr_left_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.7071081, -0.70710546, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            custom float urdf:dynamics:damping = 0
            custom float urdf:dynamics:friction = 15
            float drive:angular:physics:stiffness = 0.0
            float drive:angular:physics:damping = 0.5
            float drive:angular:physics:targetPosition = 0.0
        }

        def PhysicsRevoluteJoint "fr_steer_right_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </hunter_se_description/Geometry/base_link>
            rel physics:body1 = </hunter_se_description/Geometry/base_link/fr_steer_right_link>
            point3f physics:localPos0 = (0.34058, -0.24619, -0.1535)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -22.0
            float physics:upperLimit = 22.0
            custom float urdf:limit:effort = 0
            custom float urdf:limit:velocity = 0
            float drive:angular:physics:stiffness = 10000000.0
            float drive:angular:physics:damping = 100000.0
            float drive:angular:physics:maxForce = 6000.0
            float drive:angular:physics:targetPosition = 0.0
        }

        def PhysicsRevoluteJoint "fr_right_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </hunter_se_description/Geometry/base_link/fr_steer_right_link>
            rel physics:body1 = </hunter_se_description/Geometry/base_link/fr_steer_right_link/fr_right_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (-0.70710546, 0.7071081, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            custom float urdf:dynamics:damping = 0
            custom float urdf:dynamics:friction = 15
            float drive:angular:physics:stiffness = 0.0
            float drive:angular:physics:damping = 0.5
            float drive:angular:physics:targetPosition = 0.0
        }

        def PhysicsRevoluteJoint "re_left_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </hunter_se_description/Geometry/base_link>
            rel physics:body1 = </hunter_se_description/Geometry/base_link/re_left_link>
            point3f physics:localPos0 = (-0.2078, 0.252, -0.158)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.7071081, -0.70710546, 0, 0)
            quatf physics:localRot1 = (0, -1, 0, 0)
            custom float urdf:dynamics:damping = 0
            custom float urdf:dynamics:friction = 15
            float drive:angular:physics:stiffness = 0.0
            float drive:angular:physics:damping = 17453.0
            float drive:angular:physics:targetVelocity = 0.0
        }

        def PhysicsRevoluteJoint "re_right_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </hunter_se_description/Geometry/base_link>
            rel physics:body1 = </hunter_se_description/Geometry/base_link/re_right_link>
            point3f physics:localPos0 = (-0.2078, -0.252, -0.158)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (-0.70710546, 0.7071081, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            custom float urdf:dynamics:damping = 0
            custom float urdf:dynamics:friction = 15
            float drive:angular:physics:stiffness = 0.0
            float drive:angular:physics:damping = 17453.0
            float drive:angular:physics:targetVelocity = 0.0
        }

        def PhysicsRevoluteJoint "front_steer_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </hunter_se_description/Geometry/base_link>
            rel physics:body1 = </hunter_se_description/Geometry/base_link/front_steer_link>
            point3f physics:localPos0 = (0.40792, -0.000011431, -0.085581)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -41.25296
            float physics:upperLimit = 41.25296
            custom float urdf:limit:effort = 0
            custom float urdf:limit:velocity = 0
            float drive:angular:physics:stiffness = 10000000.0
            float drive:angular:physics:damping = 100000.0
            float drive:angular:physics:targetPosition = 0.0
        }

        def PhysicsRevoluteJoint "rear_wheel_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </hunter_se_description/Geometry/base_link>
            rel physics:body1 = </hunter_se_description/Geometry/base_link/rear_wheel_link>
            point3f physics:localPos0 = (-0.30408, -0.000011431, -0.085581)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.9999987, 0.0016194452, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float drive:angular:physics:stiffness = 10000000.0
            float drive:angular:physics:damping = 100000.0
            float drive:angular:physics:targetPosition = 0.0
        }
    }

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            point3f physics:centerOfMass = (0.037414003, -0.0003730052, -0.07712829)
            float3 physics:diagonalInertia = (0.14629452, 0.26044693, 0.37285515)
            float physics:mass = 29.39
            quatf physics:principalAxes = (0.99992067, -0.00005506678, -0.012597327, -0.000011024965)

            over "base_link_1" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
            }

            over "fr_steer_left_link" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                point3f physics:centerOfMass = (-0.00027764923, 0.016353978, 4.9734616e-9)
                float3 physics:diagonalInertia = (0.0222, 0.0222, 0.0378075)
                float physics:mass = 3.149
                quatf physics:principalAxes = (1, 0, 0, 0)

                over "box_1" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI"]
                )
                {
                }

                over "fr_left_link" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                )
                {
                    point3f physics:centerOfMass = (-3.58375e-10, 4.9734616e-9, -0.016356334)
                    float3 physics:diagonalInertia = (0.0222, 0.0222, 0.0378075)
                    float physics:mass = 3.149
                    quatf physics:principalAxes = (1, 0, 0, 0)

                    over "fr_left_link_1" (
                        prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
                    )
                    {
                        uniform token physics:approximation = "convexHull"
                    }
                }
            }

            over "fr_steer_right_link" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                point3f physics:centerOfMass = (0.00027498198, -0.016354023, -3.248024e-11)
                float3 physics:diagonalInertia = (0.0222, 0.0222, 0.0378075)
                float physics:mass = 3.149
                quatf physics:principalAxes = (1, 0, 0, 0)

                over "box_1" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI"]
                )
                {
                }

                over "fr_right_link" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                )
                {
                    point3f physics:centerOfMass = (0.00027498198, 3.248013e-11, -0.016354023)
                    float3 physics:diagonalInertia = (0.0222, 0.0222, 0.0378075)
                    float physics:mass = 3.149
                    quatf physics:principalAxes = (1, 0, 0, 0)

                    over "fr_right_link_1" (
                        prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
                    )
                    {
