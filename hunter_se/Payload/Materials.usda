#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.0"
    }
    defaultPrim = "hunter_se_description"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "hunter_se_description"
{
    def Scope "Materials"
    {
        def Material "material_1" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/material_1>
        )
        {
        }

        def Material "material_2" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/material_2>
        )
        {
        }

        def Material "material_3" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/material_3>
        )
        {
        }

        def Material "material_4" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/material_4>
        )
        {
        }

        def Material "material_5" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/material_5>
        )
        {
        }

        def Material "material_6" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/material_6>
        )
        {
        }

        def Material "material_7" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/material_7>
        )
        {
        }

        def Material "material_8" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/material_8>
        )
        {
        }

        def Material "material_9" (
            prepend references = @./MaterialsLibrary.usdc@</Materials/material_9>
        )
        {
        }
    }

    over "Geometry"
    {
        over "base_link"
        {
            over "base_link" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </hunter_se_description/Materials/material_1>
            }

            over "fr_steer_left_link"
            {
                over "box" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </hunter_se_description/Materials/material_2>
                }

                over "fr_left_link"
                {
                    over "fr_left_link" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </hunter_se_description/Materials/material_3>
                    }
                }
            }

            over "fr_steer_right_link"
            {
                over "box" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </hunter_se_description/Materials/material_4>
                }

                over "fr_right_link"
                {
                    over "fr_right_link" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </hunter_se_description/Materials/material_5>
                    }
                }
            }

            over "re_left_link"
            {
                over "re_left_link" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </hunter_se_description/Materials/material_6>
                }
            }

            over "re_right_link"
            {
                over "re_right_link" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </hunter_se_description/Materials/material_6>
                }
            }

            over "front_steer_link"
            {
                over "cylinder" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </hunter_se_description/Materials/material_8>
                }
            }

            over "rear_wheel_link"
            {
                over "cylinder" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </hunter_se_description/Materials/material_9>
                }
            }
        }
    }
}

