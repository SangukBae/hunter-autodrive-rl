#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.0"
    }
    defaultPrim = "hunter_se_autodrive_description"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

# 재질: binary MaterialsLibrary.usdc 없이 인라인으로 정의.
# body  — 짙은 회색 (AutoDRIVE Hunter SE 차체 색)
# wheel — 검정 (타이어)
# hub   — 밝은 회색 (조향 허브)
# dummy — 중간 회색 (가상 링크)

def Xform "hunter_se_autodrive_description"
{
    def Scope "Materials"
    {
        # 차체
        def Material "body_material"
        {
            token outputs:surface.connect = </hunter_se_autodrive_description/Materials/body_material/body_shader.outputs:surface>

            def Shader "body_shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.15, 0.15, 0.15)
                float inputs:metallic = 0.3
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        # 조향 허브 (좌)
        def Material "hub_left_material"
        {
            token outputs:surface.connect = </hunter_se_autodrive_description/Materials/hub_left_material/hub_shader.outputs:surface>

            def Shader "hub_shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6, 0.6, 0.6)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        # 전륜 좌 타이어
        def Material "wheel_fl_material"
        {
            token outputs:surface.connect = </hunter_se_autodrive_description/Materials/wheel_fl_material/wheel_shader.outputs:surface>

            def Shader "wheel_shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.05, 0.05)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        # 조향 허브 (우)
        def Material "hub_right_material"
        {
            token outputs:surface.connect = </hunter_se_autodrive_description/Materials/hub_right_material/hub_shader.outputs:surface>

            def Shader "hub_shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6, 0.6, 0.6)
                float inputs:metallic = 0.5
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        # 전륜 우 타이어
        def Material "wheel_fr_material"
        {
            token outputs:surface.connect = </hunter_se_autodrive_description/Materials/wheel_fr_material/wheel_shader.outputs:surface>

            def Shader "wheel_shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.05, 0.05)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        # 후륜 좌 타이어
        def Material "wheel_rl_material"
        {
            token outputs:surface.connect = </hunter_se_autodrive_description/Materials/wheel_rl_material/wheel_shader.outputs:surface>

            def Shader "wheel_shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.05, 0.05)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        # 후륜 우 타이어
        def Material "wheel_rr_material"
        {
            token outputs:surface.connect = </hunter_se_autodrive_description/Materials/wheel_rr_material/wheel_shader.outputs:surface>

            def Shader "wheel_shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.05, 0.05, 0.05)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }

        # 가상 링크 (front_steer)
        def Material "virtual_front_material"
        {
            token outputs:surface.connect = </hunter_se_autodrive_description/Materials/virtual_front_material/virt_shader.outputs:surface>

            def Shader "virt_shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.4, 0.4, 0.4)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }

        # 가상 링크 (rear_wheel)
        def Material "virtual_rear_material"
        {
            token outputs:surface.connect = </hunter_se_autodrive_description/Materials/virtual_rear_material/virt_shader.outputs:surface>

            def Shader "virt_shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.4, 0.4, 0.4)
                float inputs:metallic = 0.0
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }
    }

    over "Geometry"
    {
        over "base_link"
        {
            over "base_link" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </hunter_se_autodrive_description/Materials/body_material>
            }

            over "fr_steer_left_link"
            {
                over "box" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </hunter_se_autodrive_description/Materials/hub_left_material>
                }

                over "fr_left_link"
                {
                    over "fr_left_link" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </hunter_se_autodrive_description/Materials/wheel_fl_material>
                    }
                }
            }

            over "fr_steer_right_link"
            {
                over "box" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </hunter_se_autodrive_description/Materials/hub_right_material>
                }

                over "fr_right_link"
                {
                    over "fr_right_link" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </hunter_se_autodrive_description/Materials/wheel_fr_material>
                    }
                }
            }

            over "re_left_link"
            {
                over "re_left_link" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </hunter_se_autodrive_description/Materials/wheel_rl_material>
                }
            }

            over "re_right_link"
            {
                over "re_right_link" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </hunter_se_autodrive_description/Materials/wheel_rr_material>
                }
            }

            over "front_steer_link"
            {
                over "cylinder" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </hunter_se_autodrive_description/Materials/virtual_front_material>
                }
            }

            over "rear_wheel_link"
            {
                over "cylinder" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding = </hunter_se_autodrive_description/Materials/virtual_rear_material>
                }
            }
        }
    }
}

