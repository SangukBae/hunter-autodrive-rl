#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.0"
    }
    defaultPrim = "hunter_se_autodrive_description"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

# AutoDRIVE Hunter SE 물리 파라미터 (HunterSESceneBuilder.cs 기준)
# 축거   : 0.550 m  →  front joint X = +0.275,  rear joint X = -0.275
# 윤거   : 0.520 m  →  left joint Y = +0.260,  right joint Y = -0.260
# 바퀴 반경: 0.082 m
# 총 질량: 25 kg  (차체 ~17.5 kg + 바퀴 4 × 1.875 kg)
# 조향 한계: ±30°

def Xform "hunter_se_autodrive_description" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "NewtonArticulationRootAPI"]
)
{
    def Scope "Physics"
    {
        # ── 전륜 조향 조인트 ─────────────────────────────────────────────

        def PhysicsRevoluteJoint "fr_steer_left_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </hunter_se_autodrive_description/Geometry/base_link>
            rel physics:body1 = </hunter_se_autodrive_description/Geometry/base_link/fr_steer_left_link>
            point3f physics:localPos0 = (0.275, 0.260, -0.100)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -30.0
            float physics:upperLimit = 30.0
            custom float urdf:limit:effort = 0
            custom float urdf:limit:velocity = 0
            float drive:angular:physics:stiffness = 10000000.0
            float drive:angular:physics:damping = 100000.0
            float drive:angular:physics:maxForce = 6000.0
            float drive:angular:physics:targetPosition = 0.0
        }

        def PhysicsRevoluteJoint "fr_left_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </hunter_se_autodrive_description/Geometry/base_link/fr_steer_left_link>
            rel physics:body1 = </hunter_se_autodrive_description/Geometry/base_link/fr_steer_left_link/fr_left_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.7071081, -0.70710546, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            custom float urdf:dynamics:damping = 0
            custom float urdf:dynamics:friction = 15
            float drive:angular:physics:stiffness = 0.0
            float drive:angular:physics:damping = 0.5
            float drive:angular:physics:targetPosition = 0.0
        }

        def PhysicsRevoluteJoint "fr_steer_right_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </hunter_se_autodrive_description/Geometry/base_link>
            rel physics:body1 = </hunter_se_autodrive_description/Geometry/base_link/fr_steer_right_link>
            point3f physics:localPos0 = (0.275, -0.260, -0.100)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -30.0
            float physics:upperLimit = 30.0
            custom float urdf:limit:effort = 0
            custom float urdf:limit:velocity = 0
            float drive:angular:physics:stiffness = 10000000.0
            float drive:angular:physics:damping = 100000.0
            float drive:angular:physics:maxForce = 6000.0
            float drive:angular:physics:targetPosition = 0.0
        }

        def PhysicsRevoluteJoint "fr_right_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </hunter_se_autodrive_description/Geometry/base_link/fr_steer_right_link>
            rel physics:body1 = </hunter_se_autodrive_description/Geometry/base_link/fr_steer_right_link/fr_right_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (-0.70710546, 0.7071081, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            custom float urdf:dynamics:damping = 0
            custom float urdf:dynamics:friction = 15
            float drive:angular:physics:stiffness = 0.0
            float drive:angular:physics:damping = 0.5
            float drive:angular:physics:targetPosition = 0.0
        }

        # ── 후륜 구동 조인트 ─────────────────────────────────────────────

        def PhysicsRevoluteJoint "re_left_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </hunter_se_autodrive_description/Geometry/base_link>
            rel physics:body1 = </hunter_se_autodrive_description/Geometry/base_link/re_left_link>
            point3f physics:localPos0 = (-0.275, 0.260, -0.100)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.7071081, -0.70710546, 0, 0)
            quatf physics:localRot1 = (0, -1, 0, 0)
            custom float urdf:dynamics:damping = 0
            custom float urdf:dynamics:friction = 15
            float drive:angular:physics:stiffness = 0.0
            float drive:angular:physics:damping = 17453.0
            float drive:angular:physics:targetVelocity = 0.0
        }

        def PhysicsRevoluteJoint "re_right_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </hunter_se_autodrive_description/Geometry/base_link>
            rel physics:body1 = </hunter_se_autodrive_description/Geometry/base_link/re_right_link>
            point3f physics:localPos0 = (-0.275, -0.260, -0.100)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (-0.70710546, 0.7071081, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            custom float urdf:dynamics:damping = 0
            custom float urdf:dynamics:friction = 15
            float drive:angular:physics:stiffness = 0.0
            float drive:angular:physics:damping = 17453.0
            float drive:angular:physics:targetVelocity = 0.0
        }

        # ── 가상 조향/후륜 조인트 (잠금) ────────────────────────────────

        def PhysicsRevoluteJoint "front_steer_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </hunter_se_autodrive_description/Geometry/base_link>
            rel physics:body1 = </hunter_se_autodrive_description/Geometry/base_link/front_steer_link>
            point3f physics:localPos0 = (0.275, 0.0, -0.054)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -41.25296
            float physics:upperLimit = 41.25296
            custom float urdf:limit:effort = 0
            custom float urdf:limit:velocity = 0
            float drive:angular:physics:stiffness = 10000000.0
            float drive:angular:physics:damping = 100000.0
            float drive:angular:physics:targetPosition = 0.0
        }

        def PhysicsRevoluteJoint "rear_wheel_joint" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular"]
        )
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </hunter_se_autodrive_description/Geometry/base_link>
            rel physics:body1 = </hunter_se_autodrive_description/Geometry/base_link/rear_wheel_link>
            point3f physics:localPos0 = (-0.275, 0.0, -0.054)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.9999987, 0.0016194452, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float drive:angular:physics:stiffness = 10000000.0
            float drive:angular:physics:damping = 100000.0
            float drive:angular:physics:targetPosition = 0.0
        }
    }

    over "Geometry"
    {
        # ── base_link 물리 ───────────────────────────────────────────────
        # 차체 질량: 25 kg − 4×1.875 kg (바퀴) − 2×0.005 kg (가상) ≈ 17.49 kg
        # 관성 텐서: 기존 실물 로봇 값에서 질량비 및 축거/윤거 비율로 스케일링
        over "base_link" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        )
        {
            point3f physics:centerOfMass = (0.0375, -0.00037, -0.049)
            float3 physics:diagonalInertia = (0.088, 0.157, 0.224)
            float physics:mass = 17.49
            quatf physics:principalAxes = (0.99992067, -0.00005506678, -0.012597327, -0.000011024965)

            over "base_link_collision" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexHull"
            }

            # ── 전륜 좌 (조향 허브 + 바퀴) ─────────────────────────────
            over "fr_steer_left_link" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                point3f physics:centerOfMass = (-0.00018, 0.0104, 3.16e-9)
                float3 physics:diagonalInertia = (0.0132, 0.0132, 0.0225)
                float physics:mass = 1.875
                quatf physics:principalAxes = (1, 0, 0, 0)

                over "box_1" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI"]
                )
                {
                }

                over "fr_left_link" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                )
                {
                    point3f physics:centerOfMass = (-2.27e-10, 3.16e-9, -0.0104)
                    float3 physics:diagonalInertia = (0.0037, 0.0037, 0.0063)
                    float physics:mass = 1.875
                    quatf physics:principalAxes = (1, 0, 0, 0)

                    over "fr_left_link_collision" (
                        prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
                    )
                    {
                        uniform token physics:approximation = "boundingSphere"
                    }
                }
            }

            # ── 전륜 우 (조향 허브 + 바퀴) ─────────────────────────────
            over "fr_steer_right_link" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                point3f physics:centerOfMass = (0.00017, -0.0104, -2.06e-11)
                float3 physics:diagonalInertia = (0.0132, 0.0132, 0.0225)
                float physics:mass = 1.875
                quatf physics:principalAxes = (1, 0, 0, 0)

                over "box_1" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI"]
                )
                {
                }

                over "fr_right_link" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                )
                {
                    point3f physics:centerOfMass = (0.00017, 2.06e-11, -0.0104)
                    float3 physics:diagonalInertia = (0.0037, 0.0037, 0.0063)
                    float physics:mass = 1.875
                    quatf physics:principalAxes = (1, 0, 0, 0)

                    over "fr_right_link_collision" (
                        prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
                    )
                    {
                        uniform token physics:approximation = "boundingSphere"
                    }
                }
            }

            # ── 후륜 좌 ──────────────────────────────────────────────────
            over "re_left_link" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                point3f physics:centerOfMass = (7.9e-10, 1.1e-6, -0.0065)
                float3 physics:diagonalInertia = (0.0037, 0.0037, 0.0063)
                float physics:mass = 1.875
                quatf physics:principalAxes = (1, 0, 0, 0)

                over "re_left_link_collision" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
                )
                {
                    uniform token physics:approximation = "boundingSphere"
                }
            }

            # ── 후륜 우 ──────────────────────────────────────────────────
            over "re_right_link" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                point3f physics:centerOfMass = (0, 0, -0.0065)
                float3 physics:diagonalInertia = (0.0037, 0.0037, 0.0063)
                float physics:mass = 1.875
                quatf physics:principalAxes = (1, 0, 0, 0)

                over "re_right_link_collision" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
                )
                {
                    uniform token physics:approximation = "boundingSphere"
                }
            }

            # ── 가상 링크 (매우 가벼움) ──────────────────────────────────
            over "front_steer_link" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                point3f physics:centerOfMass = (0.049836, 8.1046e-15, 0.017912)
                float3 physics:diagonalInertia = (1.6824691e-7, 7.336131e-7, 7.549e-7)
                float physics:mass = 0.0049179
                quatf physics:principalAxes = (0.70707345, -0.70707345, 0.00686424, -0.00686424)

                over "cylinder_1" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI"]
                )
                {
                }
            }

            over "rear_wheel_link" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                point3f physics:centerOfMass = (-0.02, 0.0031269, -0.08)
                float3 physics:diagonalInertia = (9.5165393e-7, 0.000001092406, 0.0000011821)
                float physics:mass = 0.0049179
                quatf physics:principalAxes = (-0.5216815, 0.4773319, 0.52170056, 0.4773167)

                over "cylinder_1" (
                    prepend apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI"]
                )
                {
                }
            }
        }
    }
}

def PhysicsScene "PhysicsScene"
{
}

